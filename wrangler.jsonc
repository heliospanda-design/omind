{
  "name": "omind-kokowork",
  "account_id": "a18698822d1eab4df8bfe79535b2d4da",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  "kv_namespaces": [
    {
      "binding": "OMIND_SHARES",
      "id": "465a15fe4c5b41d5b4e71887d6ca3721"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OMIND_ROOM",
        "class_name": "OmindRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OmindHubDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OmindRoomDO"],
      "deleted_classes": ["OmindHubDO"]
    }
  ],
  "routes": [
    {
      "pattern": "kokowork.top",
      "custom_domain": true
    },
    {
      "pattern": "www.kokowork.top",
      "custom_domain": true
    }
  ]
}
